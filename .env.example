# Plantilla de configuracion. Copiar como .env y completar.
# El archivo .env NO se versiona (ver .gitignore).

# --- Proveedor de LLM -------------------------------------------------------
# groq   = motor principal (capa gratuita, rapido)
# gemini = respaldo en nube (puede fallar por permisos de cuenta/region)
# ollama = respaldo local sin conexion (lento en equipos sin GPU)
LLM_PROVEEDOR=groq

# Clave gratuita de Groq: https://console.groq.com/keys (sin tarjeta)
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b

# Respaldo Gemini (opcional)
GOOGLE_API_KEY=
GEMINI_MODELO=gemini-3.6-flash

# Respaldo local (requiere el servicio de Ollama en ejecucion)
OLLAMA_MODELO=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# --- Embeddings -------------------------------------------------------------
# Se ejecutan localmente: la indexacion es unica y los documentos internos
# confidenciales no salen del equipo.
EMBEDDINGS_PROVEEDOR=ollama
EMBEDDINGS_MODELO=nomic-embed-text

# --- Parametros del pipeline RAG -------------------------------------------
RAG_TAMANO_CHUNK=600
RAG_SOLAPE_CHUNK=120
RAG_TOP_K_VECTORIAL=6
RAG_TOP_K_LEXICO=6
RAG_TOP_K_FINAL=5

# --- Generacion ------------------------------------------------------------
# Temperatura baja: se busca consistencia y apego a la fuente, no creatividad.
LLM_TEMPERATURA=0.1
LLM_TIMEOUT=900

# --- Reproducibilidad ------------------------------------------------------
# Fecha de referencia de la operacion simulada. El retraso de un envio no
# entregado se calcula contra esta fecha para que las evidencias no cambien.
FECHA_OPERACION=2026-09-23
